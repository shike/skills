  "input_schema": {
    "question": "string 用户想了解的问题（必填）",
    "category": "string? 问题分类（选填，5 选 1）：love | career | self | choice | general。LLM 优先用此分类推荐 spread",
    "spread": "string 牌阵名（必填，18 选 1）：single | three-cards | time-flow | holy-triangle | celtic-cross | hexagram | two-choices | mind-body-spirit | four-elements | venus | gypsy-cross | horoscope | tree-of-life | tree-of-wealth | lovers-reunion | weekly | soulmate | find-soulmate",
    "context": "string? 附加背景（选填）",
    "intensity": "string? 解读深度（选填，default: standard）：very-light | light | standard | deep | very-deep",
    "seed": "number? 随机种子（选填，用于复现）"
  },
  "intensity_definitions": {
    "very-light": { "word_count": "1-2 句", "action_suggestions": "0 条", "use": "极简快速指引" },
