    "standard": { "word_count": "600-1200", "action_suggestions": "1 条", "use": "默认档，多数问题" },
    "deep": { "word_count": "1500-3000", "action_suggestions": "1-2 条", "use": "凯尔特十字 / 六芒星 / 生命之树" },
    "very-deep": { "word_count": "3000+", "action_suggestions": "2-3 条", "use": "多牌阵组合 / 长期跟踪" }
  },
